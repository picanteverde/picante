{
  "name": "picante",
  "version": "0.3.1",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "picante": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile dist/picante-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/index.ts --outfile dist/picante-linux-arm64",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 src/index.ts --outfile dist/picante-darwin-x64",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile dist/picante-darwin-arm64",
    "build": "mkdir -p dist && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.20.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "cheerio": "^1.2.0",
    "openai": "^7.15.0"
  }
}
